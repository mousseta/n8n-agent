PHASE 2 — Créer les 3 collections Qdrant
for c in sop_capa reglementaire documents_qualite; do
  curl -X PUT http://localhost:6333/collections/$c \
    -H 'Content-Type: application/json' \
    -d '{"vectors": {"size": 768, "distance": "Cosine"}}'

