# =========================================================================
#  Fichier .env  —  variables consommées par docker-compose.yml
#  Règle : chaque variable ici a un répondant EXPLICITE dans le compose.
#  Ne jamais committer ce fichier (ajoute-le à .gitignore).
# =========================================================================

# --- Domaine & Webhook ---------------------------------------------------
# N8N_HOST est LA variable réellement lue par le compose.
# Les anciennes WEBHOOK_URL_HOST / DOMAIN_NAME / SUBDOMAIN n'étaient
# utilisées nulle part : supprimées pour éviter la confusion.
N8N_HOST=(a renseigner)

# --- Tunnel Cloudflare ---------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=(a renseigner)

# --- Clé de chiffrement des credentials n8n ------------------------------
# ATTENTION (write-once) : si ta stack a DÉJÀ enregistré des credentials,
# GARDE la clé existante. La changer rend tous tes credentials
# indéchiffrables ("Mismatching encryption keys").
# Pour une installation NEUVE uniquement :  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Fuseau horaire (planificateurs, cron, horodatage) -------------------
GENERIC_TIMEZONE=Europe/Paris

# --- PostgreSQL ----------------------------------------------------------
# write-once : ces valeurs ne sont prises en compte qu'à la 1re création
# du volume db_storage (voir la note migration A/B dans le chat).
# Évite $ # et espaces dans le mot de passe (interprétés par Compose).
POSTGRES_USER=(a renseigner)
POSTGRES_PASSWORD=(a renseigner)
POSTGRES_DB=(a renseigner)

# --- Paquets NPM autorisés dans les nœuds Code ---------------------------
# Injecté dans n8n ET n8n-worker (c'est le worker qui exécute les nœuds Code).
NODE_FUNCTION_ALLOW_EXTERNAL=lodash,axios,moment,cheerio